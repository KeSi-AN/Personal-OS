{
  "manifest_version": 3,
  "name": "Personal OS",
  "version": "1.3.0",
  "description": "Sends page context (never raw HTML, passwords or incognito) to your local Personal OS.",
  "key": "",
  "minimum_chrome_version": "116",
  "incognito": "not_allowed",
  "permissions": [
    "tabs",
    "webNavigation",
    "idle",
    "storage",
    "alarms",
    "nativeMessaging",
    "bookmarks",
    "scripting",
    "tabGroups",
    "contextMenus"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "Personal OS"
  }
}
